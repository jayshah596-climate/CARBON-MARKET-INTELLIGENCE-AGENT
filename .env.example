# =============================================================
# Carbon Market Intelligence Agent — Environment Configuration
# =============================================================

# Required: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Tavily API Key for enhanced web search
# Get yours at https://tavily.com
# If not set, falls back to DuckDuckGo scraping
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Model configuration (defaults to claude-opus-4-6)
MODEL_NAME=claude-opus-4-6

# Optional: API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Output directory for generated reports
OUTPUT_DIR=./outputs
